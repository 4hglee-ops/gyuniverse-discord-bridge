# Discord
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_GUILD_NAME=

# Optional channel used only by local smoke/integration scripts.
DISCORD_TEST_CHANNEL_ID=

# Static bearer authentication for Remote MCP clients.
MCP_SHARED_SECRET=

# Custom GPT Actions bearer API key. Keep this separate from MCP_SHARED_SECRET.
GPT_ACTIONS_API_KEY=

# Public origin of your deployed bridge, without a trailing slash.
# Example: https://your-discord-bridge.example.com
PUBLIC_BASE_URL=

# Human approval code for OAuth authorization.
# In production, use a value distinct from MCP_SHARED_SECRET.
MCP_OAUTH_TEAM_CODE=

# HMAC signing secret for OAuth clients, authorization codes, access tokens,
# refresh tokens, and signed Team State Checkpoints.
# In production, use a dedicated value distinct from other secrets.
MCP_OAUTH_SIGNING_SECRET=
